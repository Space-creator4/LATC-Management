DISCORD_TOKEN=your-bot-token

# Your application ID from the Discord developer portal. Optional, but handy for
# identifying the bot in logs. The bot itself only needs the token above.
CLIENT_ID=000000000000000000

# Server used for instant slash command registration. Remove it to publish commands globally.
GUILD_ID=000000000000000000

# Where automod logs every action. Leave empty to turn logging off.
MODLOG_CHANNEL_ID=000000000000000000

# Role allowed to use /automod, /warnings, /roblox, /roblox-config, /verify-admin.
STAFF_ROLE_ID=000000000000000000

# Comma separated user IDs that always pass automod and can run /sync.
OWNER_IDS=000000000000000000

# Channel where the bot posts website applications. Staff can then Accept or
# Reject them with buttons. Leave empty to turn the review feed off.
APP_REVIEW_CHANNEL_ID=000000000000000000

# ---------------------------------------------------------------------------
# ATC claim panel and ATIS
# ---------------------------------------------------------------------------
# Category channel whose voice channels are the claimable ATC positions. Each VC
# is listed on the claim panel with a Claim button, so a member can go live as
# the ATC for the VC they are connected to. The bot scans this category live, so
# adding or removing VCs below updates the panel on the next claim or /atc.
ATC_CATEGORY_ID=000000000000000000

# Text channel where the claim panel embed lives. The bot posts it on startup or
# with /atc, and re-renders it whenever a claim changes or a controller leaves.
ATC_PANEL_CHANNEL_ID=000000000000000000

# Text channel that receives one ATIS embed per airport, each with its own
# Update ATIS button (Arrival and Departure fields). Leave empty to reuse the
# panel channel above.
ATC_ATIS_CHANNEL_ID=000000000000000000

# ---------------------------------------------------------------------------
# Roblox verification (bio code)
# ---------------------------------------------------------------------------
# Verification works with no Roblox account, password, cookie, .ROBLOSECURITY, or
# session token. The bot only reads public profile data:
#   https://users.roblox.com/v1/usernames/users  (name -> user id)
#   https://users.roblox.com/v1/users/{id}      (id -> public bio)
# Nothing below requires Roblox credentials.

# Role granted on success and removed on /unlink. Staff can override per server with
# /verify-admin config role:<id>. Set to 0 in that command to disable the role.
VERIFICATION_ROLE_ID=000000000000000000

# How long a code stays valid, in minutes.
VERIFY_CODE_EXPIRY_MINUTES=10

# Wrong guesses allowed per code before the member has to run /verify again.
VERIFY_MAX_ATTEMPTS=5

# Seconds a member must wait between attempts.
VERIFY_COOLDOWN_SECONDS=30

# false  = a Roblox account already linked elsewhere stays with that member.
# true   = a new holder takes it over and the old holder loses the role.
VERIFY_ALLOW_TRANSFER=false

# Whether /unlink also removes the verification role.
VERIFY_REMOVE_ROLE_ON_UNLINK=true

# Minimum seconds between outgoing Roblox API calls. Raise it if Roblox replies 429.
ROBLOX_LOOKUP_MIN_INTERVAL=0.6

# Optional Postgres/Neon connection string. When set, the bot uses Postgres
# instead of the local SQLite file defined by DB_PATH.
DATABASE_URL=

# Where the SQLite file lives when DATABASE_URL is not set.
DB_PATH=data/latc.db

LOG_LEVEL=INFO
