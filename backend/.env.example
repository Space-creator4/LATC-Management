# Copy to .env and fill in. Never commit the filled copy.
# Render reads the same keys from its dashboard's Environment tab.
#
# This file must only ever contain placeholders. It is the one file in this
# folder that is meant to be committed, so a real secret pasted here ends up in
# version control and in every clone of the repository.

NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The same Neon database the Discord bot uses. This service creates only its own
# tables (web_sessions, web_applications, web_queue_entries) with
# CREATE TABLE IF NOT EXISTS, so it is safe to point at the existing database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Browser origins
# ---------------------------------------------------------------------------
# Comma separated. These are the origins of the WEBSITE, not of this API, so
# they are the live domain and never the Render URL. Requests from any other
# origin get no CORS headers.
#
# The first entry is also where Discord sends the browser back to after login,
# so put the real site first: it becomes <first>/account/?signed_in=1.
ALLOWED_ORIGINS=https://latcm.co.uk,https://www.latcm.co.uk

# Local development, use this line instead of the one above:
# ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
# From the Discord developer portal -> your application -> General Information.
# The secret stays on the server. Never put it in Website/assets/js/config.js.
DISCORD_CLIENT_ID=REPLACE-WITH-DISCORD-CLIENT-ID
DISCORD_CLIENT_SECRET=REPLACE-WITH-DISCORD-CLIENT-SECRET

# The exact redirect URI registered under OAuth2 -> Redirects. It points at THIS
# service, not at latcm.co.uk, because Discord calls it server to server. A
# trailing slash matters: it must match character for character.
#
#   local   http://localhost:3000/auth/discord/callback
#   hosted  https://YOUR-SERVICE.onrender.com/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Bot token, used to read member roles server side AND to run the bot itself.
# Separate from the client secret so either can be rotated on its own. Without
# it, role checks cannot run, every protected feature stays closed, and the bot
# child process stays down.
#
# The bot reads this same value as DISCORD_TOKEN. Set it once, under this name.
DISCORD_BOT_TOKEN=REPLACE-WITH-BOT-TOKEN

# Snowflakes from your server with Developer Mode on (right click a role -> Copy ID).
# All three are required: role checks fail closed without them. The bot reads the
# guild id as GUILD_ID, again the same value.
DISCORD_GUILD_ID=REPLACE-WITH-GUILD-ID
PILOT_ROLE_ID=REPLACE-WITH-PILOT-ROLE-ID
ATC_ROLE_ID=REPLACE-WITH-ATC-ROLE-ID

# Optional, only used to show a staff badge in the account area.
STAFF_ROLE_ID=

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------
# Long random string, at least 32 bytes. Rotating it signs everyone out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE-WITH-RANDOM-HEX-STRING
SESSION_COOKIE_NAME=latc_session
SESSION_MAX_AGE_DAYS=30
# Defaults to true when NODE_ENV=production. Set false only for local http testing.
SESSION_SECURE=false

# ---------------------------------------------------------------------------
# Applications
# ---------------------------------------------------------------------------
# Staff intake is closed. Staff can reopen it by setting this to true and
# redeploying, without a code change.
APPLICATIONS_STAFF_OPEN=false

# ATC requires an accepted pilot, checked against their Discord pilot role.
APPLICATIONS_ATC_REQUIRES_PILOT=true

# ---------------------------------------------------------------------------
# Join queue
# ---------------------------------------------------------------------------
# The private server invite. This is deliberately not in any file under
# Website/assets, because those are public and anyone could read the link and skip
# the queue. The API returns it only to an approved member.
PRIVATE_INVITE_URL=

# true approves on accepting the rules. Set false to hold entries for staff.
QUEUE_AUTO_APPROVE=true

# ---------------------------------------------------------------------------
# Discord bot (bot/main.py)
# ---------------------------------------------------------------------------
# Everything here is read by the bot child process that this service starts.
# The four values shared with the API above are passed straight through, so they
# are not repeated. This block is only for the settings the API never uses.
#
# The bot's own bot/.env still works as a fallback for anything not set here:
# the parent process wins on a conflict, so one place is enough once filled in.

# Owner user ids, comma separated. Owners bypass every permission check.
OWNER_IDS=

# Where the bot posts its log output inside Discord.
MODLOG_CHANNEL_ID=

# Slash command panel and the channel applications are reviewed in.
APPLICATION_PANEL_CHANNEL_ID=
APPLICATION_REVIEW_CHANNEL_ID=

# Role handed out after verification passes, and the role required to be
# verified at all.
VERIFICATION_ROLE_ID=

# Verification flow tuning. Defaults are sensible; only set these to change them.
VERIFY_CODE_EXPIRY_MINUTES=
VERIFY_MAX_ATTEMPTS=
VERIFY_COOLDOWN_SECONDS=
VERIFY_ALLOW_TRANSFER=
VERIFY_REMOVE_ROLE_ON_UNLINK=

# Seconds between Roblox profile lookups, to stay under their rate limits.
ROBLOX_LOOKUP_MIN_INTERVAL=

# Where the bot keeps data when DATABASE_URL is not set. Leave empty to use the
# shared Postgres database, which is the intended configuration.
DB_PATH=

# debug, info, warning or error.
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Bot process
# ---------------------------------------------------------------------------
# false keeps the API running but never starts the bot. Defaults to true.
BOT_ENABLED=true

# Interpreter used to run bot/main.py. Leave empty and the service looks for
# bot/.venv first, then python3, python, and py. Set this only if discovery
# picks the wrong one.
PYTHON_BIN=
