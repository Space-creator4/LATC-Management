DISCORD_TOKEN=your-bot-token

# Server used for instant slash command registration. Remove it to publish commands globally.
GUILD_ID=000000000000000000

# Where /panel posts the application panel.
APPLICATION_PANEL_CHANNEL_ID=000000000000000000

# Where finished applications are sent for staff to accept or deny.
APPLICATION_REVIEW_CHANNEL_ID=000000000000000000

# Where automod logs every action. Leave empty to turn logging off.
MODLOG_CHANNEL_ID=000000000000000000

# Role allowed to use /panel, /automod, /applications, /warnings.
STAFF_ROLE_ID=000000000000000000

# Optional roles granted automatically when an application is accepted.
PILOT_ROLE_ID=000000000000000000
ATC_ROLE_ID=000000000000000000

# Comma separated user IDs that always pass automod and can run /sync.
OWNER_IDS=000000000000000000

# Roblox verification. Members check themselves with /verify username:TheirRobloxName,
# which needs none of this. Fill in the block below only if you also want members to
# sign in with Roblox instead: create an OAuth 2.0 app at
# https://create.roblox.com/dashboard/credentials, add the REDIRECT URI to its redirect
# URLs, and select the openid and profile scopes.
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
# Must match the URL registered in Roblox exactly, for example
# https://latc.example.com/roblox/callback
ROBLOX_REDIRECT_URI=
# Port the built in callback server listens on.
ROBLOX_CALLBACK_PORT=8787
# Scopes requested at sign in. Add "email" if you want the email_verified claim.
ROBLOX_SCOPES=openid profile

# Where the SQLite file lives.
DB_PATH=data/latc.db

LOG_LEVEL=INFO
